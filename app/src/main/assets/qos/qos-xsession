#!/data/data/com.termux/files/usr/bin/bash
# qos-xsession: the XFCE session qos Desktop shows, with qos's look.
#
# It sets the desktop's language and, once each, its scaling and the qos look;
# after that anything changed in XFCE's own settings stays changed. Delete the
# marker in ~/.qos to have one applied again: desktop-defaults for scaling.

SCALING_MARKER="$HOME/.qos/desktop-defaults"
LOOK_MARKER="$HOME/.qos/desktop-look-3"
BRAND_MARKER="$HOME/.qos/desktop-brand-3"
WALLPAPER_MARKER="$HOME/.qos/desktop-wallpaper-2"
DOCK_MARKER="$HOME/.qos/desktop-dock-1"
# In XFCE's own wallpaper folder, so Desktop settings lists it too.
WALLPAPER="$PREFIX/share/backgrounds/xfce/qos.jpg"

mkdir -p "$HOME/.qos"

# The desktop's language follows qos's: Settings > Language writes ~/.qos/language
# ("ta", "en", or empty for the phone's own). GLib reads these variables directly,
# so the menu shows each app's Tamil name where the app has one.
language="$(cat "$HOME/.qos/language" 2>/dev/null)"
[ -n "$language" ] || language="$(/system/bin/getprop persist.sys.locale 2>/dev/null)"
case "$language" in
    ta*) export LANGUAGE=ta LANG=ta_IN.UTF-8 ;;
    *)   export LANGUAGE=en LANG=en_US.UTF-8 ;;
esac

# Termux's glib has no translations of its own; libqosintl reads qos's Tamil
# catalogues in $PREFIX/share/locale for every program on the desktop.
if [ "$LANGUAGE" = ta ] && [ -f "$PREFIX/lib/libqosintl.so" ]; then
    export LD_PRELOAD="${LD_PRELOAD:+$LD_PRELOAD:}$PREFIX/lib/libqosintl.so"
fi

# Tamil names in the Applications menu: XFCE's menu entries and categories have
# none of their own, so in Tamil each one named in $PREFIX/share/qos/tamil-names.tsv
# gets a copy in the home folder with Name[ta] added. They are written afresh at
# every start, to follow packages as they change, and marked X-Qos-Tamil so that
# your own copies are never touched.
tamil_names() {
    local apps="$HOME/.local/share/applications" dirs="$HOME/.local/share/desktop-directories"
    local table="$PREFIX/share/qos/tamil-names.tsv" f out
    mkdir -p "$apps" "$dirs"
    grep -l '^X-Qos-Tamil=true' "$apps"/*.desktop "$dirs"/*.directory 2>/dev/null | xargs -r rm -f
    [ "$LANGUAGE" = ta ] && [ -f "$table" ] || return 0
    for f in "$PREFIX"/share/applications/*.desktop "$PREFIX"/share/desktop-directories/*.directory; do
        [ -f "$f" ] || continue
        case "$f" in *.desktop) out="$apps/${f##*/}" ;; *) out="$dirs/${f##*/}" ;; esac
        [ -e "$out" ] && continue
        awk -v table="$table" '
            BEGIN {
                while ((getline line < table) > 0)
                    if (line !~ /^#/ && split(line, p, "\t") == 2) ta[p[1]] = p[2]
            }
            /^\[/ { entry = ($0 == "[Desktop Entry]") }
            entry && /^Name\[ta\]=/ { has = 1 }
            entry && /^Name=/ && !name { name = substr($0, 6) }
            { lines[++n] = $0 }
            END {
                if (has || !(name in ta)) exit 1
                for (i = 1; i <= n; i++) {
                    print lines[i]
                    if (lines[i] == "[Desktop Entry]") print "X-Qos-Tamil=true"
                    if (lines[i] == "Name=" name && !done) { print "Name[ta]=" ta[name]; done = 1 }
                }
            }' "$f" > "$out.tmp" && mv "$out.tmp" "$out" || rm -f "$out.tmp"
    done
}
tamil_names

# Window scaling from the screen's density: phones (about 400 dpi and up) get
# everything twice the size, tablets stay at 1.
if [ ! -f "$SCALING_MARKER" ]; then
    density="$(/system/bin/getprop ro.sf.lcd_density 2>/dev/null)"
    scale=1
    [ "${density:-0}" -ge 360 ] && scale=2
    xfconf-query -c xsettings -p /Gdk/WindowScalingFactor -n -t int -s "$scale"
    if [ "$scale" = 2 ]; then
        xfconf-query -c xfwm4 -p /general/theme -n -t string -s "Default-xhdpi"
    fi
    date > "$SCALING_MARKER"
fi

# The qos look, once (marker desktop-look-3): the qos GTK theme, readable
# desktop-icon labels and qos terminal colours. Icons stay
# XFCE's own. Delete ~/.qos/desktop-look-3 to have it applied again.
if [ ! -f "$LOOK_MARKER" ]; then
    xfconf-query -c xsettings -p /Net/ThemeName -n -t string -s "qos"
    xfconf-query -c xsettings -p /Net/IconThemeName -r 2>/dev/null

    # Desktop-icon labels: white on a dark backing, whatever the wallpaper.
    xfconf-query -c xfce4-desktop -p /desktop-icons/use-custom-label-text-color -n -t bool -s true
    xfconf-query -c xfce4-desktop -p /desktop-icons/label-text-color -n \
        -t double -s 1 -t double -s 1 -t double -s 1 -t double -s 1
    xfconf-query -c xfce4-desktop -p /desktop-icons/use-custom-label-background-color -n -t bool -s true
    xfconf-query -c xfce4-desktop -p /desktop-icons/label-background-color -n \
        -t double -s 0 -t double -s 0 -t double -s 0 -t double -s 0.55

    xfconf-query -c xfce4-terminal -p /color-use-theme -n -t bool -s false
    xfconf-query -c xfce4-terminal -p /color-background -n -t string -s "#000000"
    xfconf-query -c xfce4-terminal -p /color-foreground -n -t string -s "#E9F1EF"
    xfconf-query -c xfce4-terminal -p /color-cursor -n -t string -s "#10F3BE"

    date > "$LOOK_MARKER"
fi

# The qos wallpaper, once (marker desktop-wallpaper-2). xfdesktop keys it by
# the display's name, and ignores a wrong name without a word. qos's X server
# names its display "screen" as it starts, then renames it after the Android
# display it is shown on: "builtin" for the phone's own screen, "external" or
# "dex" otherwise. So the wallpaper is set for each of those names.
if [ ! -f "$WALLPAPER_MARKER" ]; then
    xfconf-query -c xfce4-desktop -p /backdrop -r -R 2>/dev/null
    for monitor in builtin screen external dex; do
        for ws in 0 1 2 3; do
            base="/backdrop/screen0/monitor$monitor/workspace$ws"
            xfconf-query -c xfce4-desktop -p "$base/last-image" -n -t string -s "$WALLPAPER"
            xfconf-query -c xfce4-desktop -p "$base/image-style" -n -t int -s 5
            xfconf-query -c xfce4-desktop -p "$base/color-style" -n -t int -s 0
            xfconf-query -c xfce4-desktop -p "$base/rgba1" -n \
                -t double -s 0.024 -t double -s 0.063 -t double -s 0.055 -t double -s 1
        done
    done
    date > "$WALLPAPER_MARKER"
fi

# qos on the panel: the Applications menu button shows the qos mark, which is
# the q, followed by "os".
# The panel writes its layout on its first start, so wait for it, then find the
# menu button by type, not by number.
brand_panel() {
    local id kind
    for _ in $(seq 1 60); do
        for id in $(xfconf-query -c xfce4-panel -l 2>/dev/null | grep -E '^/plugins/plugin-[0-9]+$'); do
            kind="$(xfconf-query -c xfce4-panel -p "$id" 2>/dev/null)"
            case "$kind" in
                applicationsmenu|whiskermenu)
                    xfconf-query -c xfce4-panel -p "$id/button-icon" -n -t string -s "$PREFIX/share/pixmaps/qos.png"
                    xfconf-query -c xfce4-panel -p "$id/button-title" -n -t string -s "os"
                    xfconf-query -c xfce4-panel -p "$id/show-button-title" -n -t bool -s true
                    date > "$BRAND_MARKER"
                    return
                    ;;
            esac
        done
        sleep 1
    done
}
[ -f "$BRAND_MARKER" ] || brand_panel &

# The dock (the bottom panel), once (marker desktop-dock-1):
# - its gear is XFCE's Application Finder, which Termux's XFCE does not have, so
#   that empty launcher is replaced by one for the Settings Manager;
# - two launchers are added after its first separator: Android's home screen,
#   and qos's Apps screen, a touch-friendly list of every Android app.
# New launchers rather than changed ones: the panel saves its launchers' own
# settings as it restarts, over anything changed in them meanwhile.
dock_launcher() { # dock_launcher FILE.desktop: a new launcher plugin for one entry; prints its id
    last=$((last + 1))
    xfconf-query -c xfce4-panel -p "/plugins/plugin-$last" -n -t string -s launcher
    mkdir -p "$HOME/.config/xfce4/panel/launcher-$last"
    cp "$1" "$HOME/.config/xfce4/panel/launcher-$last/"
    xfconf-query -c xfce4-panel -p "/plugins/plugin-$last/items" -n -a -t string -s "${1##*/}"
}
dock_panel() {
    local id ids kind last android=() settings="" args=() placed=0 panel=/panels/panel-2/plugin-ids
    for _ in $(seq 1 60); do
        xfconf-query -c xfce4-panel -p "$panel" > /dev/null 2>&1 && break
        sleep 1
    done
    ids="$(xfconf-query -c xfce4-panel -p "$panel" 2>/dev/null | grep -E '^[0-9]+$')"
    [ -n "$ids" ] || return
    last="$(xfconf-query -c xfce4-panel -l | grep -oE '^/plugins/plugin-[0-9]+$' | grep -oE '[0-9]+$' | sort -n | tail -1)"
    for entry in qos-android-home qos-android-apps; do
        dock_launcher "$HOME/.local/share/applications/$entry.desktop"
        android+=("$last")
    done
    for id in $ids; do
        kind="$(xfconf-query -c xfce4-panel -p "/plugins/plugin-$id" 2>/dev/null)"
        if [ "$kind" = launcher ] && [ -z "$settings" ] &&
            ! xfconf-query -c xfce4-panel -p "/plugins/plugin-$id/items" 2>/dev/null | grep -q '\.desktop$'; then
            dock_launcher "$PREFIX/share/applications/xfce-settings-manager.desktop"
            settings="$last"
            id="$settings"
        fi
        args+=(-t int -s "$id")
        if [ "$placed" = 0 ] && [ "$kind" = separator ]; then
            for id in "${android[@]}"; do args+=(-t int -s "$id"); done
            placed=1
        fi
    done
    [ "$placed" = 1 ] || for id in "${android[@]}"; do args+=(-t int -s "$id"); done
    xfconf-query -c xfce4-panel -p "$panel" -a "${args[@]}"
    date > "$DOCK_MARKER"
    xfce4-panel -r
}
[ -f "$DOCK_MARKER" ] || dock_panel &

exec xfce4-session
