#!/data/data/com.termux/files/usr/bin/bash
# qos-xsession: the XFCE session qos Desktop shows.
#
# It sets the desktop's language and, once, its scaling; after that anything
# changed in XFCE's own settings stays changed. Delete ~/.qos/desktop-defaults
# to have the scaling applied again.

SCALING_MARKER="$HOME/.qos/desktop-defaults"
RESET_MARKER="$HOME/.qos/desktop-reset-1"

mkdir -p "$HOME/.qos"

# The desktop's language follows qos's: Settings > Language writes ~/.qos/language
# ("ta", "en", or empty for the phone's own). GLib reads these variables directly,
# so the menu shows each app's Tamil name where the app has one.
language="$(cat "$HOME/.qos/language" 2>/dev/null)"
[ -n "$language" ] || language="$(/system/bin/getprop persist.sys.locale 2>/dev/null)"
case "$language" in
    ta*) export LANGUAGE=ta LANG=ta_IN.UTF-8 ;;
    *)   export LANGUAGE=en LANG=en_US.UTF-8 ;;
esac

# Window scaling from the screen's density: phones (about 400 dpi and up) get
# everything twice the size, tablets stay at 1.
if [ ! -f "$SCALING_MARKER" ]; then
    density="$(/system/bin/getprop ro.sf.lcd_density 2>/dev/null)"
    scale=1
    [ "${density:-0}" -ge 360 ] && scale=2
    xfconf-query -c xsettings -p /Gdk/WindowScalingFactor -n -t int -s "$scale"
    if [ "$scale" = 2 ]; then
        xfconf-query -c xfwm4 -p /general/theme -n -t string -s "Default-xhdpi"
    fi
    date > "$SCALING_MARKER"
fi

# XFCE's own look, back. qos 0.3 to 0.5 set a qos theme, wallpaper, terminal
# colours, panel colours and About icons that made text unreadable; they are
# being redesigned. Undo every one of them, once.
if [ ! -f "$RESET_MARKER" ]; then
    xfconf-query -c xsettings -p /Net/ThemeName -r 2>/dev/null
    xfconf-query -c xsettings -p /Net/IconThemeName -r 2>/dev/null
    xfconf-query -c xfce4-desktop -p /backdrop -r -R 2>/dev/null
    for p in /color-use-theme /color-background /color-foreground /color-cursor; do
        xfconf-query -c xfce4-terminal -p "$p" -r 2>/dev/null
    done
    for id in $(xfconf-query -c xfce4-panel -l 2>/dev/null | grep -E '^/plugins/plugin-[0-9]+$'); do
        if [ "$(xfconf-query -c xfce4-panel -p "$id/button-icon" 2>/dev/null)" = "$PREFIX/share/pixmaps/qos.png" ]; then
            for p in button-icon button-title show-button-title; do
                xfconf-query -c xfce4-panel -p "$id/$p" -r 2>/dev/null
            done
        fi
    done
    for panel in $(xfconf-query -c xfce4-panel -l 2>/dev/null | grep -oE '^/panels/panel-[0-9]+' | sort -u); do
        xfconf-query -c xfce4-panel -p "$panel/background-style" -r 2>/dev/null
        xfconf-query -c xfce4-panel -p "$panel/background-rgba" -r 2>/dev/null
    done
    rm -rf "$PREFIX/share/themes/qos" "$PREFIX/share/backgrounds/qos"
    rm -f "$PREFIX/share/pixmaps/qos.png" \
        "$HOME/.local/share/icons/hicolor/256x256/apps/org.xfce.about.png" \
        "$HOME/.local/share/icons/hicolor/256x256/apps/xfce4-logo.png" \
        "$HOME/.local/share/applications/xfce4-about.desktop" \
        "$HOME/.qos/desktop-look-2" "$HOME/.qos/desktop-brand-1" "$HOME/.qos/desktop-brand-2"
    date > "$RESET_MARKER"
fi

exec xfce4-session
