#!/data/data/com.termux/files/usr/bin/sh
# qos-open: open an Android app by its package name, from the terminal or from
# qos Desktop's Android menu, e.g. qos-open com.android.chrome
#
# qos opens it for the shell: a broadcast to qos's own receiver, which only
# qos's user (this shell's) can reach.
if [ -z "${1:-}" ]; then
    echo "usage: qos-open PACKAGE" >&2
    exit 1
fi
exec am broadcast -n com.termux/com.termux.app.QosAppReceiver \
    -a com.termux.qos.OPEN_APP --es package "$1" > /dev/null
