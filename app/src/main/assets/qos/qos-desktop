#!/data/data/com.termux/files/usr/bin/bash
# qos-desktop: open the XFCE desktop on qos Desktop.
#
# The first run installs XFCE (about 100 MB) and qos-x11, the termux-x11
# command that works with qos Desktop. Every run then starts a fresh X server
# with an XFCE session; one left from before is stopped first, so nothing from
# an earlier run can get in the way.

set -eu

RELEASE="https://github.com/Maruff/qos-desktop/releases/latest/download"

if ! command -v xfce4-session >/dev/null; then
    echo "Installing the XFCE desktop (first time only)"
    pkg install -y x11-repo
    pkg update -y
    pkg install -y xfce4 xfce4-terminal dbus
fi

if ! command -v termux-x11 >/dev/null; then
    echo "Installing qos-x11"
    work="$(mktemp -d)"
    curl -fsSL -o "$work/qos-x11.deb" "$RELEASE/qos-x11.deb"
    curl -fsSL -o "$work/sha256sums.txt" "$RELEASE/sha256sums.txt"
    (cd "$work" && grep ' qos-x11.deb$' sha256sums.txt | sha256sum -c -)
    apt install -y "$work/qos-x11.deb"
    rm -rf "$work"
fi

# A fresh start: stop a desktop from before, and clear what it left behind.
pkill -f termux-x11 2>/dev/null || true
rm -f "$PREFIX/tmp/.X11-unix/X1" "$PREFIX/tmp/.X1-lock"

# Bring qos Desktop forward once the server is up. That needs qos to have the
# "Display over other apps" permission; without it, open qos Desktop yourself.
(sleep 3; am start -n com.termux.x11/com.termux.x11.MainActivity >/dev/null 2>&1 || true) &

echo "Starting the desktop. If qos Desktop does not come up by itself, open it."
exec termux-x11 :1 -xstartup "dbus-launch --exit-with-session xfce4-session"
