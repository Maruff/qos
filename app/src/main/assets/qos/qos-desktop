#!/data/data/com.termux/files/usr/bin/bash
# qos-desktop: open the XFCE desktop.
#
# The first run installs XFCE (about 100 MB). Every run then starts a fresh X
# server with an XFCE session; one left from before is stopped first, so
# nothing from an earlier run can get in the way. The X server is part of qos
# itself (from Termux:X11): it runs from qos's own APK.

set -eu

if ! command -v xfce4-session >/dev/null; then
    echo "Installing the XFCE desktop (first time only)"
    pkg install -y x11-repo
    pkg update -y
    pkg install -y xfce4 xfce4-terminal dbus
fi

# The X server's keyboard layouts, and xrandr, which names the display so
# qos-xsession can set the wallpaper for it.
[ -d "$PREFIX/share/X11/xkb" ] || pkg install -y xkeyboard-config
command -v xrandr >/dev/null || pkg install -y xorg-xrandr

if [ -z "${TERMUX_APP__APK_PATH:-}" ] || [ ! -f "$TERMUX_APP__APK_PATH" ]; then
    echo "qos's APK was not found. Close this session and open the desktop again from qos." >&2
    exit 1
fi

# The Android menu: qos writes an entry for each app on the phone, so an app
# installed or removed since last time shows as it is now.
am broadcast -n com.termux/com.termux.app.QosAppReceiver -a com.termux.qos.SYNC_APPS >/dev/null 2>&1 || true

# A fresh start: stop a desktop from before, and clear what it left behind.
pkill -f "termux-x11 com.termux" 2>/dev/null || true
rm -f "$PREFIX/tmp/.X11-unix/X1" "$PREFIX/tmp/.X1-lock"

# Show the desktop once the server is up: qos opens it for this shell.
(sleep 3; am broadcast -n com.termux/com.termux.app.QosAppReceiver -a com.termux.qos.OPEN_DESKTOP >/dev/null 2>&1 || true) &

# Start the X server as the termux-x11 command does: the session's own library
# settings are kept for xstartup, and the server's entry point runs from qos.
[ -z "${LD_LIBRARY_PATH+x}" ] || export XSTARTUP_LD_LIBRARY_PATH="$LD_LIBRARY_PATH"
[ -z "${LD_PRELOAD+x}" ] || export XSTARTUP_LD_PRELOAD="$LD_PRELOAD"
[ -z "${CLASSPATH+x}" ] || export XSTARTUP_CLASSPATH="$CLASSPATH"
export CLASSPATH="$TERMUX_APP__APK_PATH"
unset LD_LIBRARY_PATH LD_PRELOAD

echo "Starting the desktop."
exec /system/bin/app_process -Xnoimage-dex2oat / --nice-name="termux-x11 com.termux :1" \
    com.termux.x11.CmdEntryPoint :1 -xstartup "dbus-launch --exit-with-session qos-xsession"
