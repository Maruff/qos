    <string name="kit_android_desc">கைபேசியிலேயே செயலிகளைக் கட்ட Kotlin, Gradle, Java 21, ஆண்ட்ராய்டு கட்டுமானக் கருவிகள்.</string>
    <string name="kit_games">விளையாட்டுகள்</string>
    <string name="kit_games_desc">Godot, LÖVE, raylib, pygame. qos Desktop-இல் இயங்கும்.</string>
    <string name="kit_animation">வரைதலும் அசைவூட்டமும்</string>
    <string name="kit_animation_desc">qos Desktop-இல் Krita, Inkscape, GIMP; முனையத்தில் manim, ImageMagick.</string>
    <string name="kit_film">திரைப்படம்</string>
    <string name="kit_film_desc">முனையத்தில் ffmpeg; qos Desktop-இல் Kdenlive, Shotcut, Audacity.</string>
    <string name="kit_iot">IoT</string>
    <string name="kit_iot_desc">Wi-Fi வழிப் பலகைகளுக்கு MQTT-க்கான Mosquitto, தொடர் முனையங்கள், Python.</string>
    <string name="kit_security">பாதுகாப்பு</string>
    <string name="kit_security_desc">உங்கள் சொந்த அமைப்புகளைக் கற்கவும் காக்கவும்: nmap, மறையாக்கம், VPN, தீம்பொருள் சோதனை, செயலிப் பகுப்பாய்வு.</string>
    <string name="kit_ai">உள்ளூர் AI</string>
    <string name="kit_ai_desc">கைபேசியில் திறந்த மாதிரிகளை இயக்க llama.cpp, Ollama; NumPy, SciPy, ONNX Runtime.</string>
