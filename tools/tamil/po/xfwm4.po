msgid "Ma_ximize"
msgstr "பெரிதாக்கு (_X)"

msgid "Unma_ximize"
msgstr "பழைய அளவுக்கு மீட்டமை (_X)"

msgid "Mi_nimize"
msgstr "சிறிதாக்கு (_N)"

msgid "Minimize _Other Windows"
msgstr "மற்ற சாளரங்களைச் சிறிதாக்கு (_O)"

msgid "S_how"
msgstr "காட்டு (_H)"

msgid "_Move"
msgstr "நகர்த்து (_M)"

msgid "_Resize"
msgstr "அளவை மாற்று (_R)"

msgid "Always on _Top"
msgstr "எப்போதும் மேலே (_T)"

msgid "_Same as Other Windows"
msgstr "மற்ற சாளரங்களைப் போலவே (_S)"

msgid "Always _Below Other Windows"
msgstr "எப்போதும் மற்ற சாளரங்களுக்குக் கீழே (_B)"

msgid "Roll Window Up"
msgstr "சாளரத்தைச் சுருட்டு"

msgid "Roll Window Down"
msgstr "சாளரத்தை விரி"

msgid "_Fullscreen"
msgstr "முழுத்திரை (_F)"

msgid "Leave _Fullscreen"
msgstr "முழுத்திரையிலிருந்து வெளியேறு (_F)"

msgid "Context _Help"
msgstr "சூழல் உதவி (_H)"

msgid "Always on _Visible Workspace"
msgstr "எப்போதும் தெரியும் பணியிடத்தில் (_V)"

msgid "Move to Another _Workspace"
msgstr "வேறு பணியிடத்துக்கு நகர்த்து (_W)"

msgid "Move to Another Monitor"
msgstr "வேறு திரைக்கு நகர்த்து"

msgid "Destroy"
msgstr "வலிந்து மூடு"

msgid "_Quit"
msgstr "விலகு (_Q)"

msgid "Restart"
msgstr "மறுதொடக்கம்"
