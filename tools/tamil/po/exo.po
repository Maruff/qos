msgid "Use _startup notification"
msgstr "தொடக்க அறிவிப்பைப் பயன்படுத்து (_S)"

msgid "Select this option to enable startup notification when the command is run from the file manager or the menu. Not every application supports startup notification."
msgstr "கோப்பு மேலாளரிலிருந்தோ பட்டியலிலிருந்தோ கட்டளை இயக்கப்படும்போது தொடக்க அறிவிப்பை இயக்க இந்த விருப்பத்தைத் தேர்ந்தெடுங்கள். எல்லாச் செயலிகளும் தொடக்க அறிவிப்பை ஆதரிப்பதில்லை."

msgid "Run in _terminal"
msgstr "முனையத்தில் இயக்கு (_T)"

msgid "Select this option to run the command in a terminal window."
msgstr "கட்டளையை முனையச் சாளரத்தில் இயக்க இந்த விருப்பத்தைத் தேர்ந்தெடுங்கள்."

msgid "Select an icon"
msgstr "ஒரு சின்னத்தைத் தேர்ந்தெடு"

msgid "_OK"
msgstr "சரி (_O)"

msgid "Select a working directory"
msgstr "ஒரு பணி அடைவைத் தேர்ந்தெடு"

msgid "File location is not a regular file or directory"
msgstr "கோப்பு இருப்பிடம் வழக்கமான கோப்போ அடைவோ அல்ல"

msgid "Create Launcher"
msgstr "தொடக்கி உருவாக்கு"

msgid "Create Link"
msgstr "இணைப்பு உருவாக்கு"

msgid "Create Directory"
msgstr "அடைவு உருவாக்கு"

msgid "Edit Launcher"
msgstr "தொடக்கியைத் திருத்து"

msgid "Edit Link"
msgstr "இணைப்பைத் திருத்து"

msgid "Edit Directory"
msgstr "அடைவைத் திருத்து"

msgid "Failed to open display"
msgstr "காட்சித்திரையைத் திறக்க முடியவில்லை"

msgid "The Xfce development team. All rights reserved."
msgstr "Xfce உருவாக்கக் குழு. அனைத்து உரிமைகளும் பாதுகாக்கப்பட்டவை."

msgid "No file/folder specified"
msgstr "கோப்போ கோப்புறையோ குறிப்பிடப்படவில்லை"

msgid "Failed to load contents from \"%s\": %s"
msgstr "\"%s\"-இலிருந்து உள்ளடக்கத்தை ஏற்ற முடியவில்லை: %s"

msgid "The file \"%s\" contains no data"
msgstr "\"%s\" கோப்பில் தரவு எதுவும் இல்லை"

msgid "Failed to parse contents of \"%s\": %s"
msgstr "\"%s\"-இன் உள்ளடக்கத்தைப் பகுக்க முடியவில்லை: %s"

msgid "File \"%s\" has no type key"
msgstr "\"%s\" கோப்பில் வகை விசை இல்லை"

msgid "Unsupported desktop file type \"%s\""
msgstr "ஆதரிக்கப்படாத மேசைத்தளக் கோப்பு வகை \"%s\""

msgid "_Help"
msgstr "உதவி (_H)"

msgid "C_reate"
msgstr "உருவாக்கு (_R)"

msgid "_Save"
msgstr "சேமி (_S)"

msgid "Choose filename"
msgstr "கோப்புப் பெயரைத் தேர்ந்தெடு"

msgid "Failed to create \"%s\"."
msgstr "\"%s\"-ஐ உருவாக்க முடியவில்லை."

msgid "Failed to save \"%s\"."
msgstr "\"%s\"-ஐச் சேமிக்க முடியவில்லை."

msgid "Launching desktop files is not supported when %s is compiled without GIO-Unix features."
msgstr "%s GIO-Unix வசதிகள் இல்லாமல் தொகுக்கப்பட்டிருக்கும்போது மேசைத்தளக் கோப்புகளைத் தொடங்க இயலாது."

msgid "Failed to launch preferred application for category \"%s\"."
msgstr "\"%s\" வகைக்கான விருப்பச் செயலியைத் தொடங்க முடியவில்லை."

msgid "Unable to detect the URI-scheme of \"%s\"."
msgstr "\"%s\"-இன் URI திட்டத்தைக் கண்டறிய முடியவில்லை."

msgid "Failed to open URI."
msgstr "URI-ஐத் திறக்க முடியவில்லை."
